#!/usr/bin/env bash
set -u
umask 077

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
DAEMON="$ROOT/daemon"
CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}/beam-deck"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}/beam-deck"
LOG="$STATE_HOME/beam-deckd.log"
mkdir -p "$CACHE_HOME" "$STATE_HOME"

emit_missing() {
  local mise=false erl=false elixir=false mix=false
  command -v mise >/dev/null 2>&1 && mise=true
  command -v erl >/dev/null 2>&1 && erl=true
  command -v elixir >/dev/null 2>&1 && elixir=true
  command -v mix >/dev/null 2>&1 && mix=true
  printf '{"type":"snapshot","protocol":1,"onboarding":{"state":"runtime_missing","mise_available":%s,"erl_available":%s,"elixir_available":%s,"mix_available":%s,"install_command":"mise use -g erlang@latest elixir@latest"},"host":{"logical_cpus":0,"runtimes":[],"memory":{}},"nodes":[],"incidents":[],"forecasts":[],"budget_trial":null,"watchlist":{"entries":[],"error":null},"flight_recorder":{"frame_count":0,"timeline":[]},"crash_triage":[],"alerts":[],"budget":[],"history":[],"events":[],"summary":{"runtime_count":0,"distributed_count":0,"attached_count":0,"local_attached_count":0,"warning_count":0,"critical_count":0,"schedulers_online":0,"logical_cpus":0,"beam_rss_bytes":0,"process_count":0}}\n' "$mise" "$erl" "$elixir" "$mix"
}

beam_mode() {
  if command -v erl >/dev/null 2>&1 && command -v elixir >/dev/null 2>&1 && command -v mix >/dev/null 2>&1; then
    printf 'direct\n'
    return 0
  fi

  if command -v mise >/dev/null 2>&1 && mise exec -- sh -c 'command -v erl >/dev/null && command -v elixir >/dev/null && command -v mix >/dev/null' >/dev/null 2>&1; then
    printf 'mise\n'
    return 0
  fi

  return 1
}

mode="$(beam_mode || true)"
if [[ -z "$mode" ]]; then
  while :; do
    emit_missing
    sleep "${BEAM_DECK_MISSING_POLL_SECONDS:-5}"
    mode="$(beam_mode || true)"
    if [[ -n "$mode" ]]; then
      break
    fi
  done
fi

cd "$DAEMON" || exit 1
export MIX_ENV=prod
export MIX_BUILD_PATH="$CACHE_HOME/_build"
export MIX_DEPS_PATH="$CACHE_HOME/deps"
NODE_SUFFIX="${BASHPID:-$$}"

if [[ "${BEAM_DECK_LONGNAMES:-0}" == "1" ]]; then
  NODE_HOST="${BEAM_DECK_NODE_HOST:-$(hostname -f 2>/dev/null || hostname)}"
  export BEAM_DECK_LOCAL_HOST="$NODE_HOST"
  NODE_FLAG="-name beam_deck_${NODE_SUFFIX}@${NODE_HOST}"
else
  NODE_FLAG="-sname beam_deck_${NODE_SUFFIX}"
fi

# The monitor is intentionally tiny. User-supplied flags come last so an
# advanced operator can override this profile deliberately.
unset ERL_AFLAGS ERL_ZFLAGS
export ERL_FLAGS="${NODE_FLAG} -hidden +S 1:1 +SDcpu 1:1 +SDio 1 ${BEAM_DECK_ERL_FLAGS:-}"

run_mix() {
  if [[ "$mode" == "mise" ]]; then
    mise exec -- mix "$@"
  else
    mix "$@"
  fi
}

if ! run_mix compile >>"$LOG" 2>&1; then
  printf '%s\n' '{"type":"error","error":"daemon_compile_failed","reason":"Compilation failed. See the private XDG state beam-deck/beam-deckd.log; OTP 27+ and Elixir 1.18+ are required."}'
  exit 70
fi

# Keep JSONL protocol output physically separate from BEAM/Mix stdout/stderr.
# Reopening an inherited descriptor through /dev/fd is not reliable across all
# exec/runtime environments. A private FIFO provides an ordinary filesystem
# endpoint to BEAM while a tiny bridge owns the launcher's original stdout.
PROTOCOL_FIFO="$STATE_HOME/.protocol-${NODE_SUFFIX}.fifo"

if [[ -e "$PROTOCOL_FIFO" ]]; then
  rm -f -- "$PROTOCOL_FIFO"
fi

if ! mkfifo -m 600 -- "$PROTOCOL_FIFO"; then
  printf '%s\n' '{"type":"error","error":"protocol_transport_failed","reason":"Could not create the private protocol transport."}'
  exit 71
fi

bridge_pid=""
vm_pid=""

cleanup_protocol() {
  trap - EXIT

  if [[ -n "${vm_pid:-}" ]] && kill -0 "$vm_pid" 2>/dev/null; then
    kill -TERM "$vm_pid" 2>/dev/null || true
    wait "$vm_pid" 2>/dev/null || true
  fi

  if [[ -n "${bridge_pid:-}" ]] && kill -0 "$bridge_pid" 2>/dev/null; then
    kill -TERM "$bridge_pid" 2>/dev/null || true
    wait "$bridge_pid" 2>/dev/null || true
  fi

  rm -f -- "$PROTOCOL_FIFO"
}

trap cleanup_protocol EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
trap 'exit 129' HUP

cat -- "$PROTOCOL_FIFO" &
bridge_pid=$!

# cat blocks opening the FIFO until BEAM opens the writer. It must still be
# alive before launching the VM; otherwise opening the writer could block.
sleep 0.02
if ! kill -0 "$bridge_pid" 2>/dev/null; then
  printf '%s\n' '{"type":"error","error":"protocol_transport_failed","reason":"Could not start the private protocol bridge."}'
  exit 71
fi

export BEAM_DECK_PROTOCOL_PATH="$PROTOCOL_FIFO"

# Keep this shell as lifecycle owner so a termination from Quickshell can also
# terminate the VM and FIFO bridge. Explicit <&0 preserves the command channel.
if [[ "$mode" == "mise" ]]; then
  mise exec -- mix run --no-compile --no-halt <&0 >>"$LOG" 2>&1 &
else
  mix run --no-compile --no-halt <&0 >>"$LOG" 2>&1 &
fi
vm_pid=$!

set +e
wait "$vm_pid"
rc=$?
set -e
vm_pid=""

# The writer has closed. Let the bridge drain the final JSONL bytes, then
# terminate it defensively if it has not observed EOF.
for _ in $(seq 1 20); do
  if ! kill -0 "$bridge_pid" 2>/dev/null; then
    break
  fi
  sleep 0.05
done

if kill -0 "$bridge_pid" 2>/dev/null; then
  kill -TERM "$bridge_pid" 2>/dev/null || true
fi
wait "$bridge_pid" 2>/dev/null || true
bridge_pid=""

trap - EXIT TERM INT HUP
rm -f -- "$PROTOCOL_FIFO"
exit "$rc"
